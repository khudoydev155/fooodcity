# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Mini App URL (publicly hosted frontend)
MINI_APP_URL=https://your-frontend-url.com

# Webhook URL (your backend URL)
WEBHOOK_URL=https://your-backend-url.com
WEBHOOK_SECRET=your_secret_token_here

# Supabase Credentials
PROJECT_URL=https://your-project.supabase.co
SERVICE_ROLE=your_supabase_service_role_key
ANON_PUBLIC=your_supabase_anon_key

# Admin Settings
ADMIN_CHAT_ID=123456789
SUPERADMIN_IDS=[123456789]
ADMIN_PIN=123456

# Sentry (Optional for Logging/Error tracking)
SENTRY_DSN=https://your_sentry_dsn

# Click Merchant Credentials
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_MERCHANT_USER_ID=your_click_merchant_user_id

# Payme Business Credentials
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key
PAYME_TEST_MODE=true

